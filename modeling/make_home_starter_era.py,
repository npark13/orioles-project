#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Build data/out/home_starter_era.csv with columns:
  hometeam, season, home_era

Priority of sources:
  1) game-level home starter ERA in yearly games.csv (if present)
  2) seasonal tables you may already have (home_starter_gamelevel.csv or home_starter_seasonal.csv)
  3) fallback proxy: team RA/9 at home from yearly games.csv (visitor runs in home games / 9)

Usage:
  python modeling/make_home_starter_era.py --start 2014 --end 2024 --games-root data/out --out data/out/home_starter_era.csv
"""

from pathlib import Path
import argparse
import re
import sys
import warnings
import pandas as pd
import numpy as np

ERA_COL_PATTERNS = [
    r"^home_?starter_?era$",
    r"^home_?era$",
    r"^starter_?era$",
    r"^era_home$",
    r"^era$"  # last resort if clearly starter rows
]

VIS_RUNS_COL_CANDIDATES = [
    "visitor_runs","vis_runs","vis_score","v_runs","vscore","vs","VisitorRuns","visitor_score"
]

HOME_TEAM_COLS = ["hometeam","home","home_team","HomeTeam"]
VIS_TEAM_COLS  = ["visteam","away","away_team","VisTeam","visitor"]
DATE_COLS      = ["date","game_date","Date"]
GAME_ID_COLS   = ["game_id","gameid","GameID"]
DOUBLEHEADER_NO_COLS = ["number","game_number","gamenum"]

def _pick_col(cols, candidates):
    for c in candidates:
        if c in cols: return c
    return None

def _find_era_col(cols):
    for c in cols:
        for pat in ERA_COL_PATTERNS:
            if re.match(pat, c):
                return c
    return None

def _coerce_date(df):
    col = _pick_col(df.columns, DATE_COLS)
    if col is None:
        return None
    out = pd.to_datetime(df[col], errors="coerce")
    return out

def _standardize_teams(df):
    # hometeam
    hc = _pick_col(df.columns, HOME_TEAM_COLS)
    vc = _pick_col(df.columns, VIS_TEAM_COLS)
    if hc is None or vc is None:
        return None, None
    df = df.rename(columns={hc:"hometeam", vc:"visteam"})
    return df, ("hometeam","visteam")

def _maybe_read_csv(fp):
    if not fp.exists(): return None
    try:
        return pd.read_csv(fp, low_memory=False)
    except Exception as e:
        warnings.warn(f"Could not read {fp}: {e}")
        return None

def gather_from_games_era(games_dir: Path, start: int, end: int) -> pd.DataFrame | None:
    """
    If yearly games.csv already contains a column that looks like home-starter ERA,
    compute seasonal means by (hometeam, season).
    """
    rows = []
    for y in range(start, end+1):
        fp = games_dir / str(y) / "games.csv"
        g = _maybe_read_csv(fp)
        if g is None: continue
        g.columns = [str(c).strip().lower() for c in g.columns]
        era_col = _find_era_col(g.columns)
        if era_col is None:
            continue
        # require teams + date
        g, team_cols = _standardize_teams(g)
        if g is None:
            continue
        d = _coerce_date(g)
        if d is None: 
            continue
        g = g.assign(season=d.dt.year)
        # Aggregate ERA for the home starter by team-season
        # Use mean (or median) depending on availability
        tmp = (g[["hometeam","season",era_col]]
               .dropna()
               .groupby(["hometeam","season"], as_index=False)[era_col].mean()
               .rename(columns={era_col:"home_era"}))
        if len(tmp):
            rows.append(tmp)
    if not rows:
        return None
    out = pd.concat(rows, ignore_index=True).dropna()
    out["home_era"] = out["home_era"].astype(float)
    return out

def gather_from_existing_tables(root: Path) -> pd.DataFrame | None:
    """
    If you already exported something like:
      - data/out/home_starter_gamelevel.csv  (game_id, home_starter_era)
      - data/out/home_starter_seasonal.csv  (hometeam, season, home_era)
    we’ll fold those into (hometeam, season).
    """
    candidates = [
        root / "home_starter_seasonal.csv",
        root / "home_starter_era.csv",  # already in correct shape
        root / "home_starter_gamelevel.csv",
        root / "starter_stats.csv",
    ]
    acc = []

    for fp in candidates:
        df = _maybe_read_csv(fp)
        if df is None: continue
        df.columns = [c.lower() for c in df.columns]

        # direct seasonal
        if {"hometeam","season","home_era"}.issubset(df.columns):
            acc.append(df[["hometeam","season","home_era"]].dropna())
            continue

        # gamelevel -> reduce to seasonal via date
        if {"game_id","home_starter_era"}.issubset(df.columns):
            # need a games mapping to hometeam & date to get season
            # try to load a global map from data/out/*/games.csv
            # we’ll build it once
            pass  # We’ll do this outside after we scan yearly games
    if not acc:
        return None
    out = pd.concat(acc, ignore_index=True).dropna()
    out["home_era"] = out["home_era"].astype(float)
    return out

def gather_fallback_ra9(games_dir: Path, start: int, end: int) -> pd.DataFrame | None:
    """
    Fallback: compute a home RA/9 proxy per (hometeam, season) only from yearly games.csv.
    We approximate ERA with RA using visitor runs scored in those games.
    """
    rows = []
    used_vis_col = None
    for y in range(start, end+1):
        fp = games_dir / str(y) / "games.csv"
        g = _maybe_read_csv(fp)
        if g is None: continue
        g.columns = [str(c).strip().lower() for c in g.columns]

        # team columns
        g, team_cols = _standardize_teams(g)
        if g is None: 
            continue
        d = _coerce_date(g)
        if d is None:
            continue
        g = g.assign(season=d.dt.year)

        # pick a column that looks like "visitor runs"
        vcol = _pick_col(g.columns, VIS_RUNS_COL_CANDIDATES)
        if vcol is None:
            # try a heuristic: any column exactly 'r' per side?
            # Some exports use 'home_runs'/'visitor_runs' or 'home_score'/'visitor_score'
            # If we see two run columns, take the one with more unique values as visitor.
            score_like = [c for c in g.columns if re.search(r"(run|score)$", c)]
            if len(score_like) >= 2:
                # dumb heuristic: pick the smaller mean as visitor (often away runs smaller)
                means = g[score_like].mean(numeric_only=True).sort_values()
                vcol = means.index[0]
        if vcol is None or vcol not in g.columns:
            continue

        used_vis_col = used_vis_col or vcol

        agg = g.groupby(["hometeam","season"], as_index=False)[vcol].sum()
        # Approximate innings at home as 9 per game:
        counts = g.groupby(["hometeam","season"], as_index=False).size().rename(columns={"size":"games"})
        merged = agg.merge(counts, on=["hometeam","season"], how="inner")
        # RA9 proxy
        merged["home_era"] = merged[vcol] / (merged["games"] * 9.0)
        rows.append(merged[["hometeam","season","home_era"]])

    if not rows:
        return None
    out = pd.concat(rows, ignore_index=True)
    if used_vis_col:
        print(f"[fallback] Using visitor runs column: '{used_vis_col}' for RA/9 proxy")
    return out

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--start", type=int, required=True)
    ap.add_argument("--end", type=int, required=True)
    ap.add_argument("--games-root", type=str, default="data/out")
    ap.add_argument("--out", type=str, default="data/out/home_starter_era.csv")
    args = ap.parse_args()

    games_root = Path(args.games_root)
    out_fp = Path(args.out)

    # 1) Try direct home starter ERA from games.csv
    df1 = gather_from_games_era(games_root, args.start, args.end)

    # 2) Try pre-existing seasonal tables
    df2 = gather_from_existing_tables(games_root)

    # 3) Fallback proxy from totals (RA/9 at home)
    df3 = gather_fallback_ra9(games_root, args.start, args.end)

    pieces = [x for x in [df1, df2, df3] if x is not None]
    if not pieces:
        warnings.warn("Could not derive any home ERA values. Writing empty scaffold.")
        out_fp.parent.mkdir(parents=True, exist_ok=True)
        pd.DataFrame(columns=["hometeam","season","home_era"]).to_csv(out_fp, index=False)
        print(f"wrote empty {out_fp}")
        sys.exit(0)

    # Merge precedence: df1 (best) > df2 > df3 (proxy)
    base = pieces[-1].copy()
    for up in pieces[-2::-1]:
        base = base.merge(up, on=["hometeam","season"], how="outer", suffixes=("","_new"))
        if "home_era_new" in base.columns:
            base["home_era"] = np.where(base["home_era"].notna(), base["home_era"], base["home_era_new"])
            base = base.drop(columns=["home_era_new"])

    # Clean & save
    base = base.dropna(subset=["hometeam","season"]).copy()
    base["season"] = base["season"].astype(int)
    base = (base.groupby(["hometeam","season"], as_index=False)["home_era"]
                .mean())  # if duplicates remain

    out_fp.parent.mkdir(parents=True, exist_ok=True)
    base.to_csv(out_fp, index=False)
    print(f"saved {out_fp} with {len(base)} rows")

if __name__ == "__main__":
    main()
